{
  "schemaVersion": 1,
  "id": "fxap-decryptor",
  "title": "FXAP 文件夹解密",
  "version": "v1.2.3",
  "entry": "index.js",
  "node": ">=18",
  "java": {
    "required": false,
    "minimum": "8",
    "recommended": "17"
  },
  "networkRequired": true,
  "releaseAssetPattern": "fxap-only-*-windows.zip",
  "releaseChecksumAssetPattern": "fxap-only-*-windows.zip.sha256",
  "requiredFiles": [
    "index.js",
    "package.json",
    "VERSION",
    "component-manifest.json",
    "src/cloudflare-grants.js",
    "src/grants-api.js",
    "src/constants.js",
    "src/crypto.js",
    "src/decryptor.js",
    "src/discover.js",
    "src/java-decompiler.js",
    "src/keymaster.js",
    "tools/unluac54.jar",
    "tools/unluac54.jar.sha256"
  ]
}
